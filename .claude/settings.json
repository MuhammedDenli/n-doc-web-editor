{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(./runmake.sh *)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run --directory web/core *)",
      "Bash(cd web/core && uv run *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(./scripts/remove_document.sh*)",
      "Bash(scripts/remove_document.sh*)",
      "Bash(bash scripts/remove_document.sh*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in */web/core/*.py) uv run --quiet --directory \"$CLAUDE_PROJECT_DIR/web/core\" ruff format \"$f\";; esac; } 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
