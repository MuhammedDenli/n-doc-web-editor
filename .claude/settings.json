{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(./runmake.sh *)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run --directory web/core *)",
      "Bash(cd web/core && uv run *)",
      "Bash(uv run --directory web/mcp *)",
      "Bash(cd web/mcp && uv run *)",
      "mcp__ndoc__list_documents",
      "mcp__ndoc__document_tree",
      "mcp__ndoc__list_files",
      "mcp__ndoc__search",
      "mcp__ndoc__read_file",
      "mcp__ndoc__edit_file",
      "mcp__ndoc__write_file",
      "mcp__ndoc__run_checks",
      "mcp__ndoc__csv_tables",
      "mcp__ndoc__csv_read",
      "mcp__ndoc__csv_lookup",
      "mcp__ndoc__csv_insert",
      "mcp__ndoc__csv_update",
      "mcp__ndoc__csv_delete",
      "mcp__ndoc__csv_rename_key",
      "mcp__ndoc__run_build",
      "mcp__ndoc__list_build_targets",
      "mcp__ndoc__pdf_search",
      "mcp__ndoc__git_status",
      "mcp__ndoc__git_diff",
      "mcp__ndoc__git_log"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(./scripts/remove_document.sh*)",
      "Bash(scripts/remove_document.sh*)",
      "Bash(bash scripts/remove_document.sh*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in */web/core/*.py|*/web/mcp/*.py) p=\"${f#\"$CLAUDE_PROJECT_DIR\"/web/}\"; uv run --quiet --directory \"$CLAUDE_PROJECT_DIR/web/${p%%/*}\" ruff format \"$f\";; esac; } 2>/dev/null || true",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.tex|*/common/db/*.csv) uv run --quiet --project \"$CLAUDE_PROJECT_DIR/web/mcp\" ndoc-check \"$f\";; esac; }",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "ndoc"
  ]
}
